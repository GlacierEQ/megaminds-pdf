    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@vitejs/plugin-react": "6.0.4",
    "jsdom": "26.1.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
